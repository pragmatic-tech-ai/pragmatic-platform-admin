{
  "name": "@pragmatic-tech-ai/pragmatic-platform-admin",
  "version": "0.1.7",
  "private": true,
  "description": "The platform admin console (operator plane, release catalogue, co-hosted tenant plane): the pragmatic-platform-admin image.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pragmatic-tech-ai/pragmatic-platform-admin.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test \"src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json"
  },
  "dependencies": {
    "@pragmatic-tech-ai/mural": "^0.67.2",
    "@pragmatic-tech-ai/pragmatic-app-host": "^0.18.11",
    "@pragmatic-tech-ai/pragmatic-component": "^0.18.11",
    "@pragmatic-tech-ai/pragmatic-configuration-runtime": "^0.18.11",
    "@pragmatic-tech-ai/pragmatic-customer-api-contract": "^0.18.11",
    "@pragmatic-tech-ai/pragmatic-entitlements-contract": "^0.18.11",
    "@pragmatic-tech-ai/pragmatic-identity": "^0.18.11",
    "@pragmatic-tech-ai/pragmatic-identity-source-local": "^0.18.11",
    "@pragmatic-tech-ai/pragmatic-identity-source-oidc": "^0.18.11",
    "@pragmatic-tech-ai/pragmatic-identity-source-pragmatic": "^0.18.11",
    "@pragmatic-tech-ai/pragmatic-identity-store": "^0.18.11",
    "@pragmatic-tech-ai/pragmatic-kube": "^0.18.11",
    "@pragmatic-tech-ai/pragmatic-platform-link": "^0.18.11",
    "@pragmatic-tech-ai/pragmatic-protocol": "^0.14.0",
    "@pragmatic-tech-ai/pragmatic-realm-adapters": "^0.18.11",
    "@pragmatic-tech-ai/pragmatic-realm-custom": "^0.18.11",
    "@pragmatic-tech-ai/pragmatic-release-toolkit": "^0.18.11",
    "@pragmatic-tech-ai/pragmatic-tenant-plane": "^0.18.11",
    "@pragmatic-tech-ai/todl": "^0.66.5",
    "@pragmatic-tech-ai/todl-runtime": "^0.7.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.5.10",
    "pg-mem": "^3.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "pragmaticClosureCheck": {
    "Manifest": "closure.json",
    "Dockerfile": "Dockerfile",
    "Apps": [
      "pragmatic-platform-admin"
    ]
  },
  "pragmaticContainerTemplate": {
    "App": "pragmatic-platform-admin",
    "Entry": "src/server.ts",
    "UiDirs": [
      "portal"
    ],
    "ExtraCopies": [
      "release-keys"
    ],
    "WritableDirs": [
      "dist/data"
    ]
  }
}
